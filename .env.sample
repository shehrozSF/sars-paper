# Copy this file to .env and fill it in. .env is git-ignored.
# Format: KEY=VALUE, one per line, no quotes. Empty values are ignored.
# Every notebook's first cell loads .env from the working dir, its parent,
# /content/drive/MyDrive/ (Colab) or any attached /kaggle/input/*/ dataset (Kaggle).
# Variables already set in the environment (or Colab/Kaggle secrets) take precedence.

# Hugging Face tokens (https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_WRITE_TOKEN=

# Hugging Face repo ids (owner/name)
HF_REPO_ID=
HF_WORK_REPO=
HF_FALLBACK_REPO=
# optional: where complete_pipeline pushes new runs (defaults to HF_REPO_ID)
HF_RUNS_REPO=
